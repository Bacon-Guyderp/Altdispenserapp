<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform tests for the conversion core (not the Windows GUI).
       Run: "dotnet run (in tests folder)" for package tests;
            set BLENDER_PATH to also run end-to-end tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.cs" />
    <Compile Include="..\src\UnityPackage.cs" />
    <Compile Include="..\src\Converter.cs" />
    <EmbeddedResource Include="..\src\BlenderExport.py" LogicalName="Blend2Unity.BlenderExport.py" />
  </ItemGroup>
</Project>
