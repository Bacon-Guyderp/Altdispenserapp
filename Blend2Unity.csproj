<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds a single, self-contained Blend2Unity.exe for .NET Framework 4.8,
    which ships with Windows 10 and 11, so nothing needs to be installed.
    Build: dotnet build -c Release   (works on Windows, Linux or macOS)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Blend2Unity</AssemblyName>
    <RootNamespace>Blend2Unity</RootNamespace>
    <ApplicationIcon>src\app.ico</ApplicationIcon>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Blend2Unity</Product>
    <Description>Converts Blender .blend files to Unity .unitypackage files</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="src\BlenderExport.py" LogicalName="Blend2Unity.BlenderExport.py" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
